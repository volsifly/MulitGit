{
  "name": "mulitgit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "test:terminal": "node --test scripts/test-terminal-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:server": "go build ./cmd/mulitgit",
    "build:all": "npm run build && npm run build:server",
    "dev:server": "go run ./cmd/mulitgit",
    "dev:desktop": "cd cmd/mulitgit-desktop && wails dev",
    "build:desktop": "cd cmd/mulitgit-desktop && wails build",
    "install:desktop": "bash scripts/install-desktop.sh"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "vite": "^6.4.1",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12"
  }
}
